# Soltrace Configuration
# Copy this file to .env and update with your settings.
# Both binaries load .env via dotenv on startup; CLI flags override these.
# Env vars are wired with clap's `env(...)` attribute — see the Args struct
# in soltrace-live/src/main.rs and soltrace-backfill/src/main.rs.

# ────────────────────────────── Common ──────────────────────────────
# Used by both soltrace-live and soltrace-backfill.

# Database URL — auto-selected by scheme:
#   sqlite:./path.db | postgres://user:pass@host/db | mongodb://host:port
DB_URL=sqlite:./soltrace.db

# Solana HTTP RPC endpoint
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Solana WebSocket endpoint (soltrace-live only, but harmless to set globally)
SOLANA_WS_URL=wss://api.mainnet-beta.solana.com

# IDL directory path (directory containing your program IDL JSON files).
# IDLs are loaded ONCE at startup; changes need a restart.
IDL_DIR=./idls

# On-chain program IDs to fetch Anchor IDLs from via program-metadata
# (comma-separated base58, e.g. "Prog1,Prog2"). File IDLs in IDL_DIR win
# for any program present in both. Empty/unset = files only.
ONCHAIN_PROGRAMS=

# Solana commitment level: processed | confirmed | finalized
COMMITMENT=confirmed

# Program → prefix mappings (format: program_id:prefix, comma-separated).
# Event rows are named <prefix>_<EventName>. Programs absent from this
# mapping fall back to the "default" prefix.
# Example: "TRibg8W8zmPHQqWtyAD1rEBRXEdyU13Mu6qX1Sg42tJ:tributary,TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA:token"
PROGRAM_PREFIXES=

# ────────────────────────── soltrace-live only ──────────────────────
# WebSocket reconnect base delay (seconds)
RECONNECT_DELAY=5

# Maximum reconnection attempts (0 = infinite)
MAX_RECONNECT_ATTEMPTS=0

# WebSocket read-timeout / keep-alive ping interval (seconds; 0 = disable)
WS_PING_INTERVAL=30

# Max retries for RPC calls during catch-up and CPI transaction fetch
MAX_RETRIES=3

# Disable startup catch-up (gap-fill between last stored signature and tip).
# Set to any value to enable the flag; leave unset for normal catch-up.
# NO_GAP_BACKFILL=

# Kafka brokers (comma-separated). Setting this enables Kafka fan-out with
# dynamic per-event-name topics. Leave unset to disable Kafka.
# KAFKA_BROKERS=kafka:9094

# ──────────────────────── soltrace-backfill only ────────────────────
# Signature page size for get_signatures_for_address
LIMIT=1000

# Transaction fetch batch size
BATCH_SIZE=100

# Delay between batches (milliseconds)
BATCH_DELAY=100

# NOTE — these backfill knobs are CLI-only (no env binding); pass them as flags:
#   --concurrency <N>     concurrent transaction fetches      (default 10)
#   --max-retries <N>     max retry attempts for failed reqs  (default 3)

# ───────────────────────────── Logging ─────────────────────────────
# The binaries initialize tracing from RUST_LOG (EnvFilter::try_from_default_env),
# falling back to "info" when unset. Examples: info, debug, soltrace_core=debug.
RUST_LOG=info
